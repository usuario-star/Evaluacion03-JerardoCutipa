<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="72dp"
    android:paddingBottom="28dp">

    <!-- Logo grande centrado estilo Miro -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VALLEJO+"
        android:textColor="@color/brand_magenta"
        android:textSize="44sp"
        android:textStyle="bold|italic" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rincón de Vallejo"
        android:textColor="@color/brand_magenta"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Título Control de sedes -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="64dp"
        android:text="Control de sedes"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Botón 01: Google Maps -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleMaps"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="GOOGLE MAPS"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_yellow"
        app:cornerRadius="3dp" />

    <!-- Botón 02: Mantenedor -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnMantenedor"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="MANTENEDOR"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/brand_magenta"
        app:cornerRadius="3dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sello inferior estilo Miro -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_pill"
        android:gravity="center"
        android:paddingHorizontal="22dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VALLEJO+"
            android:textColor="@color/brand_yellow"
            android:textSize="16sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

</LinearLayout>
