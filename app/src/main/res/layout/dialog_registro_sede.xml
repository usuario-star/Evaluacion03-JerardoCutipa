<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_container"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvDialogTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Registro sede"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Nombre de sede -->
        <EditText
            android:id="@+id/etNombreSede"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_dialog"
            android:hint="Nombre de sede:"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="#6E6E6E"
            android:textSize="13sp" />

        <!-- Capacidad y Mesas lado a lado estilo Miro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCapacidad"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_dialog"
                android:hint="Capacidad:"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#6E6E6E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMesas"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_dialog"
                android:hint="Mesas:"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#6E6E6E"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Especialidad usando Spinner (AdapterView) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_dialog"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/spEspecialidad"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- Gerente -->
        <EditText
            android:id="@+id/etGerente"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_dialog"
            android:hint="Gerente:"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="#6E6E6E"
            android:textSize="13sp" />

        <!-- Jefe de Personal -->
        <EditText
            android:id="@+id/etJefePersonal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_dialog"
            android:hint="Jefe de Personal:"
            android:inputType="textPersonName"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="#6E6E6E"
            android:textSize="13sp" />

        <!-- Coordenadas (Lat.-Lon) -->
        <EditText
            android:id="@+id/etCoordenadas"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_dialog"
            android:hint="Coordenadas: -8.1116, -79.0288"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="#6E6E6E"
            android:textSize="13sp" />

        <!-- Botón Registrar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarSede"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="REGISTRAR"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_magenta"
            app:cornerRadius="6dp" />

    </LinearLayout>
</ScrollView>
